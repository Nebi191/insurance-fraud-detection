        "rationale": "Meslek; gelir, eğitim ve demografi için güçlü vekildir.",
        "used_as_model_feature": true,
        "split_count": 10,
        "has_influence": true
      },
      {
        "feature": "insured_hobbies",
        "basis": "lifestyle_proxy",
        "rationale": "SHAP'ta yüksek etkili çıkıyor; yaşam tarzı/kültürel köken vekili olabilir ve nedensel bir dolandırıcılık gerekçesi yoktur.",
